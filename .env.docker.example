# Docker Compose overrides (local + production).
# Copy to .env.docker and run:
#   docker compose --env-file .env.docker up -d --build
#
# Or append the DOCKER_* keys to your shell / CI secrets.
# These names intentionally differ from the XAMPP .env (APP_URL, DB_HOST, …).

# --- App ---
DOCKER_APP_ENV=production
# Public URL browsers use (scheme + host + port if non-default)
DOCKER_APP_URL=http://217.218.238.207
# Host ports published to nginx (container listens on 80 / 443)
DOCKER_HTTP_PORT=80
DOCKER_HTTPS_PORT=443

# Socket.IO (browser-facing URL usually matches APP_URL when proxied at /socket.io/)
DOCKER_SOCKET_PUBLIC_URL=http://217.218.238.207
DOCKER_SOCKET_CORS_ORIGIN=http://217.218.238.207,https://217.218.238.207,http://127.0.0.1,https://127.0.0.1
DOCKER_SOCKET_EMIT_SECRET=changeme-emit-secret

# API
DOCKER_TRANSACTION_API_KEY=changeme-transaction-key

# --- Database (internal Compose network; DB_HOST is always "db") ---
DOCKER_DB_NAME=loan_registrarer
DOCKER_DB_USER=loanapp
DOCKER_DB_PASS=loanapp
DOCKER_MYSQL_ROOT_PASSWORD=changeme-root
